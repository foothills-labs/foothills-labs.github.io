  "color": {
    "butterscotch": {
      "value": "#E7A63E",
      "comment": "The one hot colour. A fill, never an ink. The glyph fill and the accent of both dark schemes."
    },
    "coral": {
      "value": "#F7A283",
      "comment": "Warm pastel. A fill and a panel ground; never an ink."
    },
    "blush": {
      "value": "#F7DDD3",
      "comment": "Pale warm pink. Raised surface on the cel ground."
    },
    "duckegg": {
      "value": "#CBDFD4",
      "comment": "Pale green. Raised surface on notepad; second series on dark."
    },
    "smoke": {
      "value": "#9DACBA",
      "comment": "Blue-grey. Recessive detail and rules; never body text."
    },
    "emerald": {
      "value": "#376F71",
      "comment": "Emerald sea, darkened a step. The accent ink on light grounds; a panel ground on dark."
    },
    "sumi": {
      "value": "#2B2422",
      "comment": "Warm near-black, like ink that has dried. Primary text on light; the outline colour of every drawing."
    },
    "washi": {
      "value": "#FAF6ED",
      "comment": "Warm paper white. Light ground; primary text on dark."
    },
    "white": {
      "value": "#FFFFFF",
      "comment": "Ground of notepad; surfaces on washi."
    },
    "clay": {
      "value": "#B85C40",
      "comment": "Derived: coral fired dark. Second chart series on light grounds."
    },
    "night": {
      "value": "#22474A",
      "comment": "Derived from emerald sea: deep water. Primary dark ground."
    },
    "slate": {
      "value": "#2D5559",
      "comment": "Raised surface on night."
    },
    "print": {
      "value": "#333E48",
      "comment": "Derived from smoke: smoked slate. Dark ground for benchmarks and tools."
    },
    "drafting": {
      "value": "#3E4A55",
      "comment": "Raised surface on print."
    }
  },
