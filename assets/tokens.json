  "meta": {
    "name": "Foothills Labs",
    "source": "docs/brand.md",
    "note": "Generated by assets/tokens/build.py. Edit docs/brand.md, then regenerate.",
    "palette": "chalk",
    "audit": "all sanctioned pairings clear AA"
  },
  "color": {
    "butterscotch": {
      "value": "#E7A63E",
      "comment": "The one hot colour. A fill, never an ink. The glyph fill and the accent of both dark schemes."
    },
    "rose": {
      "value": "#EE93A9",
      "comment": "Cool-leaning pink. A fill and a panel ground; never an ink. Replaces the card's coral, which sat in terracotta's family."
    },
    "chalk": {
      "value": "#EDF1F0",
      "comment": "Cool paper white. The light ground, and text on the dark ones."
    },
    "white": {
      "value": "#FFFFFF",
      "comment": "Ground of notepad; surfaces on chalk."
    },
    "mist": {
      "value": "#DCE6E6",
      "comment": "Raised cool surface. Tiles, table rows, code blocks."
    },
    "duckegg": {
      "value": "#CBDFD4",
      "comment": "Pale green. Second chart series on the dark grounds."
    },
    "smoke": {
      "value": "#9DACBA",
      "comment": "Blue-grey. Recessive detail and rules; never body text."
    },
    "emerald": {
      "value": "#2F6E70",
      "comment": "Emerald sea, darkened for ink duty. The accent ink on light grounds; a panel ground on dark."
    },
    "plum": {
      "value": "#8E4763",
      "comment": "Derived: rose fired dark. Second chart series on the light grounds."
    },
    "sumi": {
      "value": "#26292B",
      "comment": "Cool near-black, like ink that has dried. Primary text on light; the outline colour of every drawing."
    },
    "night": {
      "value": "#1E3C40",
      "comment": "Derived from emerald sea: deep water. Primary dark ground."
    },
    "slate": {
      "value": "#23464A",
      "comment": "Raised surface on night."
    },
    "print": {
      "value": "#2E3A42",
      "comment": "Derived from smoke: smoked slate. Dark ground for benchmarks and tools."
    },
    "drafting": {
      "value": "#38444C",
      "comment": "Raised surface on print."
    }
  },
