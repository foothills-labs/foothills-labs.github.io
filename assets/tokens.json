{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Foothills Labs",
    "source": "docs/brand.md",
    "note": "Generated by assets/tokens/build.py. Edit docs/brand.md, then regenerate.",
    "palette": "harbour",
    "colourway": "beacon",
    "audit": "all sanctioned pairings clear AA"
  },
  "color": {
    "butterscotch": {
      "value": "#EE8B33",
      "comment": "The one hot colour, and the accent INK of the dark schemes only. On the cream paper it manages 2.1:1, so on light grounds it is a fill and nothing else \u2014 that asymmetry is the reason the guard token exists."
    },
    "rose": {
      "value": "#6A2A12",
      "comment": "Burnt rust. The accent ink on light grounds (9.2:1 on cream) and a facet of the mark. Keeps the token name so nothing downstream has to move."
    },
    "chalk": {
      "value": "#FAEBD3",
      "comment": "Warm paper. The light ground, and text on the dark ones. b* +13.5 \u2014 a golden cream, deliberately not a bone: Anthropic's is +4.1."
    },
    "white": {
      "value": "#FFFFFF",
      "comment": "Ground of notepad."
    },
    "mist": {
      "value": "#DEEAEE",
      "comment": "Raised cool surface on white. Tiles, table rows, code blocks."
    },
    "duckegg": {
      "value": "#9ABCC6",
      "comment": "Pale teal. First chart series on the dark grounds."
    },
    "smoke": {
      "value": "#829AA1",
      "comment": "Derived mid. Recessive detail and rules; never body text."
    },
    "emerald": {
      "value": "#31606D",
      "comment": "The cool counterweight. Chart series on light grounds; a panel ground on dark."
    },
    "plum": {
      "value": "#FFB881",
      "comment": "Derived: the hot colour lifted. Second chart series on the dark grounds."
    },
    "sumi": {
      "value": "#05192B",
      "comment": "Near-black navy. Primary text on light; the outline colour of every drawing."
    },
    "night": {
      "value": "#05192B",
      "comment": "The primary dark ground. Same value as sumi: the ink and the ground are one colour, which is what makes the cream sit so far forward."
    },
    "slate": {
      "value": "#132538",
      "comment": "Raised surface on night."
    },
    "print": {
      "value": "#082C35",
      "comment": "Deep teal. Dark ground for benchmarks and tools."
    },
    "drafting": {
      "value": "#1D3E47",
      "comment": "Raised surface on print. Sits at L*24 and no higher: the accent has to clear 4.5 on top of it."
    },
    "warmwhite": {
      "value": "#FFF9EF",
      "comment": "Raised surface on the cream ground. Lighter than the paper, not whiter than it."
    }
  },
